DATABASE_HOST = 'localhost'
DATABASE_PORT = 3306
DATABASE_USERNAME = 'root'
DATABASE_PASSWORD = 'root'
DATABASE_NAME = 'demo_tiny_pro'
DATABASE_SYNCHRONIZE = true
DATABASE_AUTOLOADENTITIES = true
AUTH_SECRET = 'secret'
REDIS_SECONDS = 7200
REDIS_HOST = 'localhost'
REDIS_PORT = 6379
EXPIRES_IN = '2h'
PAGINATION_PAGE = 1
PAGINATION_LIMIT = 10
GLOBAL_PREFIX = '/'
MOCK_REGEX = '/mock'
# 7天
REFRESH_TOKEN_TTL=604800000

# 至多有多少个设备可以同时在线
DEVICE_LIMIT=2
# 是否启用演示模式
PREVIEW_MODE=false
ENABLE_SWAGGER=true
