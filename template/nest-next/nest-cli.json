{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "webpack": true,
    "assets": [
      "./i18n",
      {
        "include": "../configs/*",
        "outDir": "./dist/config"
      }
    ],
    "watchAssets": true,
    "deleteOutDir": false
  },
  "projects": {
    "configure": {
      "type": "library",
      "root": "libs/configure",
      "entryFile": "index",
      "sourceRoot": "libs/configure/src",
      "compilerOptions": {
        "tsConfigPath": "libs/configure/tsconfig.lib.json"
      }
    },
    "shared": {
      "type": "library",
      "root": "libs/shared",
      "entryFile": "index",
      "sourceRoot": "libs/shared/src",
      "compilerOptions": {
        "tsConfigPath": "libs/shared/tsconfig.lib.json"
      }
    }
  }
}
