{
  "name": "designer-demo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently 'pnpm:serve:mock' 'pnpm:serve:frontend'",
    "build:alpha": "cross-env NODE_OPTIONS=--max-old-space-size=10240 vite build --mode alpha",
    "build": "cross-env NODE_OPTIONS=--max-old-space-size=10240 vite build",
    "serve:frontend": "cross-env vite",
    "serve:mock": "node -e \"require('@opentiny/tiny-engine-mock')\"",
  },
  "dependencies": {
    "@opentiny/icons": "^0.1.4",
    "@opentiny/tiny-engine": "^2.7.0",
    "@opentiny/tiny-engine-generate-code-tinypro": "^0.1.0",
    "@opentiny/tiny-engine-meta-register": "^2.7.0",
    "@opentiny/tiny-engine-utils": "^2.7.0",
    "@opentiny/vue": "~3.32.0",
    "@opentiny/vue-design-smb": "~3.32.0",
    "@opentiny/vue-icon": "~3.32.0",
    "@opentiny/vue-locale": "~3.32.0",
    "@opentiny/vue-renderless": "~3.20.0",
    "@opentiny/vue-theme": "~3.32.0",
    "@vueuse/core": "^9.6.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@opentiny/tiny-engine-mock": "^2.7.0",
    "@opentiny/tiny-engine-vite-config": "^2.7.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "baseline-browser-mapping": "2.11.37",
    "concurrently": "^8.2.0",
    "cross-env": "^7.0.3",
    "vite": "^8.3.6"
  }
}