VITE_CONTEXT=/vue-pro/
VITE_BASE_API=/api
VITE_SERVER_HOST= http://127.0.0.1:3000
VITE_MOCK_HOST= http://127.0.0.1:8848
VITE_USE_MOCK= false
VITE_MOCK_IGNORE=

VITE_MOCK_SERVER_HOST=/mock
VITE_LOWCODE_DESIGNER_ENABLED=true
# 设计器链接配置，开发环境默认为 http://localhost:8090，生产环境可配置为 /designer 或完整 URL
VITE_LOWCODE_DESIGNER_URL=http://localhost:8090

# 可选集成的页面功能开关，由 tiny init pro 根据用户多选结果改写
VITE_TINY_ROBOT_ENABLED=true
VITE_TINY_EDITOR_ENABLED=true

# TinyRobot 大模型配置：proxy=走后端代理（key 留在服务端，推荐）；direct=前端直连（key 会暴露在前端，仅内网/demo）
# 默认示例为通义千问（支持联网搜索，enable_search 通过 EXTRA_BODY 传入）；key 需自行申请
# 其他可选服务：DeepSeek（无联网搜索） BASE_URL=https://api.deepseek.com MODEL=deepseek-chat EXTRA_BODY 留空
# Kimi（支持联网搜索） BASE_URL=https://api.moonshot.cn/v1 MODEL=moonshot-v1-8k EXTRA_BODY={"tools":[{"type":"builtin_function","function":{"name":"$web_search"}}]}
VITE_ROBOT_LLM_MODE=proxy
VITE_ROBOT_LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VITE_ROBOT_LLM_API_KEY=sk-ws-H.PHEXLEL.k36s.MEQCIHFHMfx9nrBA7nJvhbPEcy7PqqlEICiOW2dW8_vbwPQ0AiArAqO_4Q05PuhboIKPGe4uXnwkQVcn3XgIIOolxfGGOw
VITE_ROBOT_LLM_MODEL=qwen-plus
VITE_ROBOT_LLM_EXTRA_BODY={"enable_search":true}
VITE_ROBOT_LLM_PROXY_URL=/api/robot/chat
