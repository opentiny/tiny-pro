VITE_CONTEXT=/vue-pro/
VITE_BASE_API=/api
VITE_SERVER_HOST= http://127.0.0.1:3000
VITE_MOCK_HOST= http://127.0.0.1:8848
VITE_USE_MOCK= false
VITE_MOCK_IGNORE=

VITE_MOCK_SERVER_HOST=/mock
VITE_LOWCODE_DESIGNER_ENABLED=true
# 设计器链接配置，开发环境默认为 http://localhost:8090，生产环境可配置为 /designer 或完整 URL
VITE_LOWCODE_DESIGNER_URL=http://localhost:8090

# 可选集成的页面功能开关，由 tiny init pro 根据用户多选结果改写
VITE_TINY_ROBOT_ENABLED=false
VITE_TINY_EDITOR_ENABLED=false

# 模拟登录开关，由 tiny init pro ：仅前端项目为 true（登录不请求后端，模拟登录成功）
VITE_MOCK_LOGIN_ENABLED=false
