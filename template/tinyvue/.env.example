# Optional custom model endpoints. Leave blank to use official Provider defaults.
VITE_QWEN_API_URL=
VITE_DEEPSEEK_API_URL=

# Optional custom MCP endpoint. Leave blank to use the official endpoint.
VITE_AMAP_MCP_URL=

# Optional local direct-connection credentials (development only).
# WARNING: VITE_* values are embedded in the client bundle. Do not use production keys.
VITE_ALIYUN_DASHSCOPE_KEY=
VITE_DEEPSEEK_API_KEY=

# Optional collaboration editing WebSocket server (y-websocket).
# Leave blank to disable collaboration. Never use the public Yjs demo server in production.
VITE_COLLAB_WEBSOCKET_URL=
