# Optional custom model endpoints. Leave blank to use official Provider defaults.
VITE_QWEN_API_URL=
VITE_DEEPSEEK_API_URL=

# Optional custom MCP endpoint. Leave blank to use the official endpoint.
VITE_AMAP_MCP_URL=

# Optional local direct-connection credentials (development only).
# WARNING: VITE_* values are embedded in the client bundle. Do not use production keys.
VITE_ALIYUN_DASHSCOPE_KEY=
VITE_DEEPSEEK_API_KEY=

# Optional collaboration editing WebSocket server (y-websocket). Two steps:
# 1. Default: when left blank, the app falls back to the public Yjs demo server
#    (wss://demos.yjs.dev/ws) for testing only. Content is synced to a third-party
#    server and room names are predictable — do NOT use it for real documents.
# 2. Recommended: set your own self-hosted y-websocket server address, e.g.
#    VITE_COLLAB_WEBSOCKET_URL=wss://your-domain/ws (dev: .env.development,
#    prod: CI env var or .env.production). Takes priority over the demo server.
VITE_COLLAB_WEBSOCKET_URL=
